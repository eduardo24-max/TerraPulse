# Copia las líneas que necesites a backend/.env (ese archivo no se sube a GitHub).

# Terra ya habla con una voz neuronal gratuita (edge-tts), sin clave. Opcional: otra voz, p. ej. es-MX-JorgeNeural
# TERRA_VOICE=es-MX-DaliaNeural

# OPCIONAL: voz de ElevenLabs y mejor oído a distancia. Clave en https://elevenlabs.io → Developers → API Keys
ELEVENLABS_API_KEY=
# Opcional: id de otra voz de tu cuenta de ElevenLabs (por defecto, una voz femenina incluida)
# ELEVENLABS_VOICE_ID=
# Opcional: modelos (por defecto eleven_turbo_v2_5 y scribe_v1)
# ELEVENLABS_TTS_MODEL=
# ELEVENLABS_STT_MODEL=

# Conversación completa en tiempo real (Gemini Live). Clave en https://aistudio.google.com/apikey
GEMINI_API_KEY=
